{
  "name": "stellplatz-maps-finder",
  "version": "2.0.0",
  "description": "Route planning with parking, camper and camping POIs",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "supabase:login": "npx supabase login",
    "supabase:link": "npx supabase link --project-ref hhonilnfkmqppcsrwzbk",
    "deploy:edge": "npx supabase functions deploy api --no-verify-jwt",
    "deploy:email": "node scripts/deploy-email-templates.mjs",
    "dev": "vite",
    "build": "npm run build:client",
    "build:client": "vite build",
    "preview": "vite preview",
    "generate-pwa-assets": "pwa-assets-generator && pwa-assets-generator -c pwa-assets.splash.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.config.int.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-static": "^1.17.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.55.11",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20.14.2",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^8.2.2",
    "jsdom": "^29.1.1",
    "msw": "^2.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "vite": "^7.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
